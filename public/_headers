# Security Headers
# https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers

# Enable HSTS (HTTP Strict Transport Security)
Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Prevent MIME type sniffing
X-Content-Type-Options: nosniff

# Enable XSS protection
X-XSS-Protection: 1; mode=block

# Prevent clickjacking
X-Frame-Options: SAMEORIGIN

# Referrer policy
Referrer-Policy: strict-origin-when-cross-origin

# Content Security Policy (CSP)
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self' https:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# Permissions Policy
Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Cross-Origin Resource Sharing (CORS)
Access-Control-Allow-Origin: https://azizaspa.com
Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
Access-Control-Allow-Headers: Content-Type, Authorization
Access-Control-Allow-Credentials: true

# Cache-Control
Cache-Control: public, max-age=31536000, immutable

# Feature Policy
Feature-Policy: vibrate 'none'; ambient-light-sensor 'none'; autoplay 'none'; camera 'none'; encrypted-media 'none'; fullscreen 'self'; geolocation 'none'; microphone 'none'; midi 'none'; payment 'none'; picture-in-picture 'none'; speaker 'none'; sync-xhr 'none'; usb 'none'; vr 'none';

# Expect-CT
Expect-CT: max-age=86400, enforce

# Cross-Origin-Embedder-Policy
Cross-Origin-Embedder-Policy: require-corp

# Cross-Origin-Opener-Policy
Cross-Origin-Opener-Policy: same-origin

# Cross-Origin-Resource-Policy
Cross-Origin-Resource-Policy: same-site

# Server
Server: AzizaSpa/1.0

# X-Powered-By
X-Powered-By: Aziza Spa
